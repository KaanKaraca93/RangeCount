{
  "openapi": "3.0.0",
  "info": {
    "title": "Ipekyol Range Sayaç API",
    "version": "1.0.0",
    "description": "PLM Range Planning & Tracking API - Koleksiyon planlama ve range takip sistemi",
    "contact": {
      "name": "Ipekyol PLM Team",
      "email": "plm@ipekyol.com.tr"
    }
  },
  "servers": [
    {
      "url": "https://rangecount-652fcc1f20d9.herokuapp.com",
      "description": "Production Server"
    }
  ],
  "tags": [
    {
      "name": "Range Data",
      "description": "Koleksiyon range verileri ve istatistikler"
    },
    {
      "name": "Range Details",
      "description": "Kumaş tipi bazında detaylı range verileri"
    },
    {
      "name": "PLM Style Data",
      "description": "PLM'den style ve geçen sezon verileri"
    },
    {
      "name": "PLM Range Data",
      "description": "PLM'den gerçek ürün kategorisi range verileri"
    },
    {
      "name": "PLM Theme Data",
      "description": "PLM'den gerçek tema bazlı veriler"
    },
    {
      "name": "PLM D-Cluster",
      "description": "D-Cluster (FreeFieldOne='D') ürünlerinin tema ve kategori bazında takibi"
    },
    {
      "name": "Range Count Source",
      "description": "Placeholder bazlı plan vs gerçekleşen karşılaştırması (ham data, pivotlanmamış)"
    },
    {
      "name": "Banner",
      "description": "Banner için özet metrikler"
    },
    {
      "name": "Token",
      "description": "PLM OAuth2.0 token yönetimi"
    }
  ],
  "paths": {
    "/api/ranges": {
      "get": {
        "tags": ["Range Data"],
        "summary": "Tüm range verilerini getir",
        "description": "53 satır range verisi döndürür",
        "responses": {
          "200": {
            "description": "Başarılı",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "count": {
                      "type": "integer",
                      "example": 53
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/RangeData"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/ranges/summary": {
      "get": {
        "tags": ["Range Data"],
        "summary": "Özet istatistikler",
        "description": "Genel ve grup bazında tamamlanma istatistikleri",
        "responses": {
          "200": {
            "description": "Başarılı",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SummaryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/ranges/lifestyle/{group}": {
      "get": {
        "tags": ["Range Data"],
        "summary": "Life Style Grup'a göre filtrele",
        "parameters": [
          {
            "name": "group",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["Business", "Essential", "Mono", "Tema"]
            },
            "example": "Mono"
          }
        ],
        "responses": {
          "200": {
            "description": "Başarılı"
          }
        }
      }
    },
    "/api/ranges/product/{group}": {
      "get": {
        "tags": ["Range Data"],
        "summary": "Ürün Alt Grup'a göre filtrele",
        "parameters": [
          {
            "name": "group",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "ELBISE"
          }
        ],
        "responses": {
          "200": {
            "description": "Başarılı"
          }
        }
      }
    },
    "/api/range-details": {
      "get": {
        "tags": ["Range Details"],
        "summary": "Tüm range detay verilerini getir",
        "description": "Kumaş tipi bazında 13 satır detay verisi",
        "responses": {
          "200": {
            "description": "Başarılı",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "count": {
                      "type": "integer",
                      "example": 13
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/RangeDetailData"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/range-details/detail/{lifeStyleGroup}/{productGroup}": {
      "get": {
        "tags": ["Range Details"],
        "summary": "Belirli grup kombinasyonunun detayı",
        "parameters": [
          {
            "name": "lifeStyleGroup",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Mono"
          },
          {
            "name": "productGroup",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "ELBISE"
          }
        ],
        "responses": {
          "200": {
            "description": "Başarılı"
          }
        }
      }
    },
    "/api/range-details/fabric/{type}": {
      "get": {
        "tags": ["Range Details"],
        "summary": "Kumaş tipine göre filtrele",
        "parameters": [
          {
            "name": "type",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["Dokuma", "Triko", "Örme", "Kumaş Mix"]
            },
            "example": "Dokuma"
          }
        ],
        "responses": {
          "200": {
            "description": "Başarılı"
          }
        }
      }
    },
    "/api/range-details/summary/fabric": {
      "get": {
        "tags": ["Range Details"],
        "summary": "Kumaş tipi bazında özet",
        "responses": {
          "200": {
            "description": "Başarılı"
          }
        }
      }
    },
    "/api/past-season-data": {
      "get": {
        "tags": ["PLM Style Data"],
        "summary": "Geçen sezon verilerini getir (Random POC)",
        "description": "POC için random geçen sezon verileri döndürür. PLM'e bağlanmaz, her istekte farklı random değerler üretir.",
        "responses": {
          "200": {
            "description": "Başarılı",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "sellout": {
                          "type": "integer",
                          "description": "Satış adedi"
                        },
                        "markdown": {
                          "type": "number",
                          "description": "İndirim oranı %"
                        },
                        "ros": {
                          "type": "number",
                          "description": "Rate of Sale %"
                        },
                        "salesPerformance": {
                          "type": "string",
                          "enum": ["best", "excellent", "good", "average", "below average", "poor"],
                          "description": "Satış performans etiketi"
                        },
                        "fobCostUSD": {
                          "type": "number",
                          "description": "FOB maliyet (USD)"
                        },
                        "fabricCost": {
                          "type": "number",
                          "description": "Kumaş maliyeti (USD)"
                        },
                        "trimCost": {
                          "type": "number",
                          "description": "Aksesuar maliyeti (USD)"
                        },
                        "laborCost": {
                          "type": "number",
                          "description": "İşçilik maliyeti (USD)"
                        },
                        "embroideryCost": {
                          "type": "number",
                          "description": "Nakış maliyeti (USD)"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/plm-style/{styleId}": {
      "get": {
        "tags": ["PLM Style Data"],
        "summary": "PLM'den style bilgisi getir",
        "parameters": [
          {
            "name": "styleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 158
          }
        ],
        "responses": {
          "200": {
            "description": "Başarılı"
          }
        }
      }
    },
    "/api/plm-ranges": {
      "get": {
        "tags": ["PLM Range Data"],
        "summary": "PLM'den gerçek range verilerini getir",
        "description": "Excel plan verileri ile PLM gerçek verilerini eşleştirip hesaplar",
        "responses": {
          "200": {
            "description": "Başarılı",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "marka": {
                            "type": "string"
                          },
                          "kategori": {
                            "type": "string"
                          },
                          "lifeStyleGrup": {
                            "type": "string"
                          },
                          "urunAltGrup": {
                            "type": "string"
                          },
                          "pOpt": {
                            "type": "integer"
                          },
                          "tOpt": {
                            "type": "integer"
                          },
                          "gOpt": {
                            "type": "integer"
                          },
                          "fark": {
                            "type": "integer"
                          },
                          "oran": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/plm-ranges/summary": {
      "get": {
        "tags": ["PLM Range Data"],
        "summary": "PLM range özet istatistikleri",
        "description": "Genel ve grup bazında tamamlanma istatistikleri",
        "responses": {
          "200": {
            "description": "Başarılı"
          }
        }
      }
    },
    "/api/plm-themes": {
      "get": {
        "tags": ["PLM Theme Data"],
        "summary": "PLM'den gerçek tema verilerini getir",
        "description": "Excel tema hedefleri ile PLM gerçek verilerini eşleştirip hesaplar",
        "responses": {
          "200": {
            "description": "Başarılı",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "temaAdi": {
                            "type": "string"
                          },
                          "temaId": {
                            "type": "integer"
                          },
                          "pOpt": {
                            "type": "integer"
                          },
                          "tOpt": {
                            "type": "integer"
                          },
                          "gOpt": {
                            "type": "integer"
                          },
                          "fark": {
                            "type": "integer"
                          },
                          "oran": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/plm-themes/summary": {
      "get": {
        "tags": ["PLM Theme Data"],
        "summary": "PLM tema özet istatistikleri",
        "description": "Genel tema tamamlanma istatistikleri",
        "responses": {
          "200": {
            "description": "Başarılı"
          }
        }
      }
    },
    "/api/plm-d-cluster": {
      "get": {
        "tags": ["PLM D-Cluster"],
        "summary": "D-Cluster ürün takibi",
        "description": "FreeFieldOne='D' olan ürünlerin SubCategory ve Tema (AGU/EYL/EKM) bazında takibi. ColorwayStatus=4 ve ThemeId=1172 olanlar exclude edilir.",
        "responses": {
          "200": {
            "description": "Başarılı",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "count": {
                      "type": "integer",
                      "example": 14
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "subCategory": {
                            "type": "string",
                            "example": "BLUZ"
                          },
                          "subCategoryId": {
                            "type": "integer",
                            "example": 21
                          },
                          "agu": {
                            "type": "object",
                            "properties": {
                              "plan": {
                                "type": "integer",
                                "description": "Planlanan option sayısı"
                              },
                              "tOpt": {
                                "type": "integer",
                                "description": "Taslak option sayısı (Status=1)"
                              },
                              "gOpt": {
                                "type": "integer",
                                "description": "Gerçekleşen option sayısı (Status!=1)"
                              },
                              "total": {
                                "type": "integer",
                                "description": "Toplam option (tOpt + gOpt)"
                              },
                              "fark": {
                                "type": "integer",
                                "description": "Fark (total - plan). Pozitif=Fazla, Negatif=Eksik"
                              },
                              "oran": {
                                "type": "string",
                                "example": "87%"
                              }
                            }
                          },
                          "eyl": {
                            "type": "object",
                            "description": "Eylül dönemi (ThemeId: 1121, 1122, 1126)"
                          },
                          "ekm": {
                            "type": "object",
                            "description": "Ekim dönemi (ThemeId: 1123, 1124, 1127)"
                          },
                          "top": {
                            "type": "object",
                            "properties": {
                              "plan": {
                                "type": "integer"
                              },
                              "total": {
                                "type": "integer"
                              },
                              "fark": {
                                "type": "integer"
                              },
                              "oran": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "description": {
                          "type": "string",
                          "example": "D-Cluster ürünleri (FreeFieldOne=D)"
                        },
                        "themeGroups": {
                          "type": "object",
                          "properties": {
                            "AGU": {
                              "type": "array",
                              "items": {
                                "type": "integer"
                              },
                              "example": [1118, 1119, 1120, 1125]
                            },
                            "EYL": {
                              "type": "array",
                              "items": {
                                "type": "integer"
                              },
                              "example": [1121, 1122, 1126]
                            },
                            "EKM": {
                              "type": "array",
                              "items": {
                                "type": "integer"
                              },
                              "example": [1123, 1124, 1127]
                            }
                          }
                        },
                        "excludeRules": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "example": [
                            "ColorwayStatus = 4 (iptal)",
                            "ThemeId = 1172 (iptal)",
                            "FreeFieldOne != D (sadece D cluster)"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/range-count-source": {
      "get": {
        "tags": ["Range Count Source"],
        "summary": "Placeholder bazlı plan vs gerçekleşen (ham data)",
        "description": "Excel küp raporu için placeholder seviyesinde ham veri. Her satır = 1 placeholder veya planlanmamış colorway. Sadece Cluster='B' filtrelenir, diğer alanlar null olabilir.",
        "responses": {
          "200": {
            "description": "Başarılı",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "count": {
                      "type": "integer",
                      "example": 859
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "marka": {
                            "type": "string",
                            "example": "IPEKYOL"
                          },
                          "brandId": {
                            "type": "integer"
                          },
                          "opsiyonKodu": {
                            "type": "string",
                            "nullable": true,
                            "description": "Placeholder kodu (PH1, PH2, ...). null ise planlanmamış",
                            "example": "PH1"
                          },
                          "urunGrubu": {
                            "type": "string",
                            "example": "BLUZ"
                          },
                          "subCategoryId": {
                            "type": "integer"
                          },
                          "urunAltGrup": {
                            "type": "string",
                            "example": "BLUZ"
                          },
                          "subSubCategoryId": {
                            "type": "integer"
                          },
                          "fashionPyramid": {
                            "type": "string",
                            "nullable": true,
                            "example": "Fashion Newness"
                          },
                          "fashionPyramidId": {
                            "type": "integer",
                            "nullable": true
                          },
                          "lifeStyleGrup": {
                            "type": "string",
                            "nullable": true,
                            "example": "Tema"
                          },
                          "lifeStyleGrupId": {
                            "type": "integer",
                            "nullable": true
                          },
                          "ft": {
                            "type": "string",
                            "nullable": true,
                            "example": "FT"
                          },
                          "ftId": {
                            "type": "integer",
                            "nullable": true
                          },
                          "segment": {
                            "type": "string",
                            "nullable": true,
                            "example": "Segment 3"
                          },
                          "segmentId": {
                            "type": "integer",
                            "nullable": true
                          },
                          "planOptionSay": {
                            "type": "integer",
                            "description": "Planlanan option sayısı (0 veya 1)"
                          },
                          "gerceklesenOptionSay": {
                            "type": "integer",
                            "description": "Gerçekleşen colorway sayısı"
                          },
                          "gerceklesenUrunKodu": {
                            "type": "string",
                            "description": "Gerçekleşen StyleCode'lar (virgülle ayrılmış)"
                          },
                          "gerceklesenRenkKodu": {
                            "type": "string",
                            "description": "Gerçekleşen Colorway Code'lar"
                          },
                          "gerceklesenRenkAdi": {
                            "type": "string",
                            "description": "Gerçekleşen Colorway Name'ler"
                          }
                        }
                      }
                    },
                    "summary": {
                      "type": "object",
                      "properties": {
                        "toplamPlanlanan": {
                          "type": "integer"
                        },
                        "toplamGerceklesen": {
                          "type": "integer"
                        },
                        "fark": {
                          "type": "integer"
                        },
                        "eslesen": {
                          "type": "integer",
                          "description": "Plan=1 ve Gerçekleşen>0"
                        },
                        "sadecePlanlanan": {
                          "type": "integer",
                          "description": "Plan=1, Gerçekleşen=0"
                        },
                        "sadaceGerceklesen": {
                          "type": "integer",
                          "description": "Plan=0, Gerçekleşen>0"
                        },
                        "toplamKayit": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/range-count-source/summary": {
      "get": {
        "tags": ["Range Count Source"],
        "summary": "Sadece özet istatistikler",
        "description": "Ham data olmadan sadece özet metrikler",
        "responses": {
          "200": {
            "description": "Başarılı"
          }
        }
      }
    },
    "/api/banner": {
      "get": {
        "tags": ["Banner"],
        "summary": "Banner için özet metrikleri",
        "description": "Ürün kategorisi ve tema bazlı tamamlanma metriklerini döner",
        "responses": {
          "200": {
            "description": "Başarılı",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "urunKategorisi": {
                          "type": "object",
                          "properties": {
                            "toplamPOpt": {
                              "type": "integer"
                            },
                            "toplamGOpt": {
                              "type": "integer"
                            },
                            "fark": {
                              "type": "integer"
                            },
                            "tamamlanmaOrani": {
                              "type": "string"
                            }
                          }
                        },
                        "tema": {
                          "type": "object",
                          "properties": {
                            "toplamPOpt": {
                              "type": "integer"
                            },
                            "toplamGOpt": {
                              "type": "integer"
                            },
                            "fark": {
                              "type": "integer"
                            },
                            "tamamlanmaOrani": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/token": {
      "get": {
        "tags": ["Token"],
        "summary": "PLM Access Token Al",
        "description": "OAuth2.0 access token döndürür",
        "responses": {
          "200": {
            "description": "Başarılı",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RangeData": {
        "type": "object",
        "properties": {
          "marka": {
            "type": "string",
            "example": "IPEKYOL"
          },
          "kategori": {
            "type": "string",
            "example": "TEKSTIL"
          },
          "lifeStyleGrup": {
            "type": "string",
            "enum": ["Business", "Essential", "Mono", "Tema"],
            "example": "Mono"
          },
          "urunAltGrup": {
            "type": "string",
            "example": "ELBISE"
          },
          "pOpt": {
            "type": "integer",
            "description": "Planlanan option sayısı",
            "example": 56
          },
          "tOpt": {
            "type": "integer",
            "description": "Taslak option sayısı",
            "example": 4
          },
          "gOpt": {
            "type": "integer",
            "description": "Gerçekleşen option sayısı",
            "example": 53
          },
          "fark": {
            "type": "integer",
            "description": "pOpt - gOpt",
            "example": 3
          },
          "oran": {
            "type": "string",
            "description": "Tamamlanma oranı",
            "example": "95%"
          }
        }
      },
      "RangeDetailData": {
        "type": "object",
        "properties": {
